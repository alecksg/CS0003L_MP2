section .data
    Message db 0x48, 0x41, 0x44, 0x4A, 0x49, 0x20, 0x54, 0x45, 0x4A, 0x55, 0x43, 0x4F
    MessageLen equ $ - Message

section .text
global _start

_start:
    mov eax, 4
    mov ebx, 1
    mov ecx, Message
    mov edx, MessageLen
    int 0x80

    mov eax, 1
    xor ebx, ebx
    int 0x80
