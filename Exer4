section .data
    clearScreen db 27, '[2J'
    clearScreen_len equ $ - clearScreen

    moveCursor1 db 27, '[1;38H'
    moveCursor1_len equ $ - moveCursor1
    text1 db "hadji", 10
    text1_len equ $ - text1

    moveCursor2 db 27, '[2;36H'
    moveCursor2_len equ $ - moveCursor2
    text2 db "tejuco", 10
    text2_len equ $ - text2

    moveCursor3 db 27, '[5;37H'
    moveCursor3_len equ $ - moveCursor3
    text3 db "javier", 10
    text3_len equ $ - text3

section .text
    global _start

_start:
    call clearTheScreen
    call displayText1
    call displayText2
    call displayText3
    call exitProgram

clearTheScreen:
    mov eax, 4
    mov ebx, 1
    mov ecx, clearScreen
    mov edx, clearScreen_len
    int 0x80
    ret

displayText1:
    mov eax, 4
    mov ebx, 1
    mov ecx, moveCursor1
    mov edx, moveCursor1_len
    int 0x80

    mov eax, 4
    mov ebx, 1
    mov ecx, text1
    mov edx, text1_len
    int 0x80
    ret

displayText2:
    mov eax, 4
    mov ebx, 1
    mov ecx, moveCursor2
    mov edx, moveCursor2_len
    int 0x80

    mov eax, 4
    mov ebx, 1
    mov ecx, text2
    mov edx, text2_len
    int 0x80
    ret

displayText3:
    mov eax, 4
    mov ebx, 1
    mov ecx, moveCursor3
    mov edx, moveCursor3_len
    int 0x80

    mov eax, 4
    mov ebx, 1
    mov ecx, text3
    mov edx, text3_len
    int 0x80
    ret

exitProgram:
    mov eax, 1
    xor ebx, ebx
    int 0x80
